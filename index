<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doğukan & Egemen</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>

<div class="stars"></div>

<div class="seal-container" id="sealContainer">
  <img src="images/seal.png" class="seal" id="seal" />
  <p>Mühüre Dokun</p>
</div>

<div class="main-content" id="mainContent">

  <audio id="music" loop>
    <source src="music/bu-gece.mp3" type="audio/mp3">
  </audio>

  <section class="hero">
    <h1>Doğukan & Egemen</h1>
    <p>Vega ve Altair'in altında sonsuzluğa...</p>
  </section>

  <section class="countdown-section">
    <h2>Düğüne Kalan Süre</h2>
    <div id="countdown"></div>
  </section>

  <section class="location">
    <h2>Konum</h2>
    <p>Görgülü Hotel — Edirne / Keşan</p>

    <iframe
      src="https://www.google.com/maps?q=Görgülü+Hotel+Keşan&output=embed"
      width="100%"
      height="300"
      style="border:0; border-radius:20px"
      allowfullscreen=""
      loading="lazy">
    </iframe>
  </section>

  <section class="rsvp">
    <h2>Katılım Formu</h2>

    <form action="https://formsubmit.co/dgkngngr97@gmail.com" method="POST">
      <input type="text" name="name" placeholder="Ad Soyad" required>
      <input type="number" name="person" placeholder="Kaç Kişi" required>
      <textarea name="message" placeholder="Mesajınız"></textarea>

      <button type="submit">Gönder</button>
    </form>
  </section>

</div>

<script src="script.js"></script>
</body>
</html>