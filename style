* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #050816;
  color: white;
  font-family: 'Georgia', serif;
  overflow-x: hidden;
}

.stars {
  position: fixed;
  width: 100%;
  height: 100%;
  background: url('images/stars-bg.jpg') center/cover;
  z-index: -1;
  opacity: 0.5;
}

.seal-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  cursor: pointer;
}

.seal {
  width: 180px;
  transition: transform 1s ease;
}

.seal:hover {
  transform: scale(1.05);
}

.main-content {
  display: none;
  animation: fadeIn 2s ease;
}

.hero {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.hero h1 {
  font-size: 4rem;
  margin-bottom: 20px;
}

.hero p {
  font-size: 1.3rem;
}

.countdown-section,
.location,
.rsvp {
  padding: 80px 20px;
  max-width: 800px;
  margin: auto;
  text-align: center;
}

#countdown {
  margin-top: 20px;
  font-size: 2rem;
}

form {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 30px;
}

input,
textarea {
  padding: 15px;
  border-radius: 15px;
  border: none;
  font-size: 1rem;
}

button {
  padding: 15px;
  border: none;
  border-radius: 15px;
  background: #d4af37;
  color: black;
  font-size: 1rem;
  cursor: pointer;
}

button:hover {
  transform: scale(1.03);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}